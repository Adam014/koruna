{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The built SPA served as static assets, plus a Worker that only answers /api/*.
  "name": "koruna",
  "compatibility_date": "2026-11-01",
  "main": "./worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "routes": [{ "pattern": "momence.stadnik.dev", "custom_domain": true }],
  // Serve only on the custom domain, not also on <name>.<account>.workers.dev.
  "workers_dev": false,
  "observability": { "enabled": true },
}
